{
  "schema_version": 1,
  "name": "crf-smoke",
  "stage": "pilot",
  "split": "train",
  "seed": 42,
  "inputs": [
    "configs/crf.json",
    "requirements-crf.txt",
    "scripts/baseline_crf.py",
    "scripts/run_job.py",
    "ragtruth_data/data.py",
    "ragtruth_data/alignment.py",
    "ragtruth_data/schema.py",
    "data/splits/split_manifest_v1.csv",
    "data/splits/split_summary_v1.json",
    "data/processed/train.jsonl",
    "data/processed/crf_train.jsonl",
    "data/processed/validation.jsonl",
    "data/processed/crf_validation.jsonl"
  ],
  "command": [
    "{python}", "scripts/baseline_crf.py", "train", "--config", "configs/crf.json",
    "--seed", "{seed}", "--output", "{run_dir}", "--limit-train", "300", "--limit-validation", "100"
  ],
  "expected_outputs": ["crf_summary.json", "crf_report.md", "validation_predictions.jsonl",
                       "validation_predictions_response_only.jsonl",
                       "models/source/model_config.json",
                       "models/source/evident_conflict.crfsuite", "models/source/subtle_conflict.crfsuite",
                       "models/source/evident_baseless_info.crfsuite", "models/source/subtle_baseless_info.crfsuite",
                       "models/response_only/model_config.json",
                       "models/response_only/evident_conflict.crfsuite", "models/response_only/subtle_conflict.crfsuite",
                       "models/response_only/evident_baseless_info.crfsuite", "models/response_only/subtle_baseless_info.crfsuite"],
  "timeout_seconds": 900
}
